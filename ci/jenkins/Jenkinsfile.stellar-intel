// Manual, CPU-only Level-1 CI for Princeton's Stellar Intel cluster.
//
// Configure the Jenkins job to load *this file* from a reviewed, trusted CI
// branch while Level 1 is being brought up. The PR checkout below is
// intentionally separate: a pull request must not be able to replace the
// pipeline that decides what SLURM work to submit. Once validated, the job can
// move to main without changing this file.

properties([
    buildDiscarder(logRotator(
        numToKeepStr: '20',
        artifactNumToKeepStr: '20'
    )),
    disableConcurrentBuilds(),
    parameters([
        string(
            name: 'PR_NUMBER',
            defaultValue: '',
            trim: true,
            description: 'Required GitHub pull-request number to build and test.'
        )
    ])
])

def requireValue(String name, String value) {
    value = value?.trim()
    if (!value) {
        error("${name} is not configured. See ci/jenkins/README.stellar-intel.md.")
    }
    return value
}

def buildJobs() {
    def value = (env.STELLAR_BUILD_JOBS ?: '3').trim()
    return positiveInteger('STELLAR_BUILD_JOBS', value)
}

def positiveInteger(String name, String value) {
    if (!(value ==~ /[1-9][0-9]*/)) {
        error("${name} must be a positive integer, got '${value}'.")
    }
    return value
}

def regressionJobs() {
    return positiveInteger(
        'STELLAR_REGRESSION_JOBS',
        (env.STELLAR_REGRESSION_JOBS ?: '4').trim()
    )
}

def regressionTestTimeout() {
    return positiveInteger(
        'STELLAR_REGRESSION_TEST_TIMEOUT',
        (env.STELLAR_REGRESSION_TEST_TIMEOUT ?: '900').trim()
    )
}

def checkoutPullRequest(String credentialsId) {
    checkout([
        $class: 'GitSCM',
        branches: [[name: "refs/remotes/origin/pr/${params.PR_NUMBER}"]],
        doGenerateSubmoduleConfigurations: false,
        extensions: [
            [$class: 'CleanBeforeCheckout'],
            [$class: 'CloneOption', depth: 1, honorRefspec: true, noTags: true, shallow: true]
        ],
        userRemoteConfigs: [[
            credentialsId: credentialsId,
            refspec: "+refs/pull/${params.PR_NUMBER}/head:refs/remotes/origin/pr/${params.PR_NUMBER}",
            url: 'https://github.com/gkeyllorg/gkeyll.git'
        ]]
    ])
}

def checkoutRegressionBaseline(String credentialsId) {
    checkout([
        $class: 'GitSCM',
        branches: [[name: 'refs/remotes/origin/baseline']],
        doGenerateSubmoduleConfigurations: false,
        extensions: [
            [$class: 'CleanBeforeCheckout'],
            [$class: 'CloneOption', depth: 1, honorRefspec: true, noTags: true, shallow: true]
        ],
        userRemoteConfigs: [[
            credentialsId: credentialsId,
            refspec: '+refs/heads/agent_tools-jenkins-stellar_intel-baseline:refs/remotes/origin/baseline',
            url: 'https://github.com/gkeyllorg/gkeyll.git'
        ]]
    ])
}

def publishGitHubCommitStatus(String credentialsId, String commit, String state, String description) {
    if (!(commit ==~ /[0-9a-f]{40}/)) {
        error("Cannot publish a GitHub status for invalid commit SHA '${commit}'.")
    }
    if (!['pending', 'success', 'failure', 'error'].contains(state)) {
        error("Invalid GitHub commit-status state '${state}'.")
    }

    // Bind the token only for this trusted API request, never while a shell
    // command from the PR checkout is running.
    withCredentials([usernamePassword(
        credentialsId: credentialsId,
        usernameVariable: 'GITHUB_STATUS_USERNAME',
        passwordVariable: 'GITHUB_STATUS_TOKEN'
    )]) {
        withEnv([
            "GITHUB_STATUS_COMMIT=${commit}",
            "GITHUB_STATUS_STATE=${state}",
            "GITHUB_STATUS_DESCRIPTION=${description}"
        ]) {
            sh '''#!/bin/bash
                set -euo pipefail

                payload="$(printf '{"state":"%s","context":"continuous-integration/jenkins/stellar-intel","description":"%s"}' "${GITHUB_STATUS_STATE}" "${GITHUB_STATUS_DESCRIPTION}")"
                curl --fail --silent --show-error \
                    --retry 2 --connect-timeout 15 --max-time 45 \
                    --request POST \
                    --header 'Accept: application/vnd.github+json' \
                    --header 'X-GitHub-Api-Version: 2022-11-28' \
                    --header "Authorization: Bearer ${GITHUB_STATUS_TOKEN}" \
                    --header 'Content-Type: application/json' \
                    --data "$payload" \
                    --output /dev/null --write-out 'GitHub Stellar status: %{http_code}\\n' \
                    "https://api.github.com/repos/gkeyllorg/gkeyll/statuses/${GITHUB_STATUS_COMMIT}"
            '''
        }
    }
}

def submitSlurmJob(String kind, String payload, String cpus, String timeLimit, List<String> extraExports = []) {
    def qos = requireValue('STELLAR_SLURM_QOS', env.STELLAR_SLURM_QOS)
    def account = env.STELLAR_SLURM_ACCOUNT?.trim()
    def idFile = "slurm-${kind}-job-id.txt"
    def statusFile = "slurm-${kind}-job-status.txt"
    def outputFile = "slurm-${kind}-%j.out"
    def exports = [
        "CI_WORKSPACE=${env.WORKSPACE}",
        "CI_SLURM_JOB_KIND=${kind}",
        "CI_SLURM_JOB_ID_FILE=${idFile}",
        "CI_SLURM_JOB_STATUS_FILE=${statusFile}"
    ] + extraExports

    withEnv([
        "CI_WORKSPACE=${env.WORKSPACE}",
        "CI_SLURM_JOB_KIND=${kind}",
        "CI_SLURM_JOB_ID_FILE=${idFile}",
        "CI_SLURM_JOB_STATUS_FILE=${statusFile}",
        "CI_STELLAR_QOS=${qos}",
        "CI_STELLAR_TIME=${timeLimit}",
        "CI_STELLAR_ACCOUNT=${account ?: ''}",
        "CI_STELLAR_CPUS=${cpus}",
        "CI_SLURM_PAYLOAD=${payload}",
        "CI_SLURM_EXPORTS=${exports.join(',')}",
        "CI_SLURM_OUTPUT=${outputFile}"
    ]) {
        sh '''#!/bin/bash -l
            set -euo pipefail

            job_id=''

            write_status() {
                printf 'job_id=%s\nstate=%s\nexit_code=%s\n' \
                    "$job_id" "$1" "${2:-}" > "$CI_SLURM_JOB_STATUS_FILE"
            }

            cancel_submitted_job() {
                trap - INT TERM
                if [[ -z "$job_id" ]]; then
                    exit 143
                fi

                echo "Jenkins interrupted; cancelling Slurm job $job_id"
                scancel "$job_id" || true
                while :; do
                    state="$(squeue --noheader --jobs="$job_id" --format='%T' | head -n 1 || true)"
                    if [[ -z "$state" ]]; then
                        break
                    fi
                    echo "Waiting for Slurm job $job_id to stop (state: $state)"
                    sleep 5
                done
                write_status 'CANCELLED_BY_JENKINS'
                exit 143
            }

            trap cancel_submitted_job INT TERM

            sbatch_args=(
                --parsable
                "--job-name=gkyl-ci-${CI_SLURM_JOB_KIND}-${BUILD_NUMBER}"
                --nodes=1
                --ntasks=1
                "--cpus-per-task=${CI_STELLAR_CPUS}"
                "--qos=${CI_STELLAR_QOS}"
                "--time=${CI_STELLAR_TIME}"
                "--output=${CI_WORKSPACE}/${CI_SLURM_OUTPUT}"
                "--chdir=${CI_WORKSPACE}"
                "--export=ALL,${CI_SLURM_EXPORTS}"
            )
            if [[ -n "${CI_STELLAR_ACCOUNT:-}" ]]; then
                sbatch_args+=("--account=${CI_STELLAR_ACCOUNT}")
            fi

            submission="$(sbatch "${sbatch_args[@]}" "$CI_SLURM_PAYLOAD")"
            job_id="${submission%%;*}"
            if [[ ! "$job_id" =~ ^[0-9]+(_[0-9]+)?$ ]]; then
                echo "ERROR: Could not parse Slurm job ID from: $submission" >&2
                exit 1
            fi
            printf '%s\n' "$job_id" > "$CI_SLURM_JOB_ID_FILE"
            echo "Submitted ${CI_SLURM_JOB_KIND} Slurm job $job_id"

            previous_state=''
            while :; do
                state="$(squeue --noheader --jobs="$job_id" --format='%T' | head -n 1 || true)"
                if [[ -z "$state" ]]; then
                    break
                fi
                if [[ "$state" != "$previous_state" ]]; then
                    echo "${CI_SLURM_JOB_KIND} Slurm job $job_id state: $state"
                    previous_state="$state"
                fi
                sleep 5
            done

            # Slurm accounting can lag briefly after a job disappears from
            # squeue. Query the allocation record only (-X) until it appears.
            record=''
            for attempt in {1..6}; do
                record="$(sacct --noheader --parsable2 --allocations --jobs="$job_id" \
                    --format=State,ExitCode | head -n 1 || true)"
                if [[ -n "$record" ]]; then
                    break
                fi
                echo "Waiting for Slurm accounting record for job $job_id ($attempt/6)"
                sleep 5
            done
            if [[ -z "$record" ]]; then
                write_status 'UNKNOWN'
                echo "ERROR: No Slurm accounting record found for job $job_id" >&2
                exit 1
            fi

            final_state="${record%%|*}"
            exit_code="${record#*|}"
            write_status "$final_state" "$exit_code"
            echo "${CI_SLURM_JOB_KIND} Slurm job $job_id finished: state=$final_state exit_code=$exit_code"
            if [[ "$final_state" == COMPLETED* && "$exit_code" == '0:0' ]]; then
                exit 0
            fi
            exit 1
        '''
    }
}

def submitUnitTests() {
    submitSlurmJob(
        'unit',
        'ci/jenkins/slurm-unit-tests.stellar-intel.sh',
        '4',
        (env.STELLAR_SLURM_TIME ?: '00:30:00').trim()
    )
}

def submitRegressionTests() {
    def jobs = regressionJobs()
    def timeout = regressionTestTimeout()
    submitSlurmJob(
        'regression',
        'ci/jenkins/slurm-regression-tests.stellar-intel.sh',
        '8',
        (env.STELLAR_REGRESSION_TIME ?: '04:00:00').trim(),
        [
            "CI_BASELINE_DIR=${env.WORKSPACE}/_baseline",
            "CI_BASELINE_PREFIX=${env.WORKSPACE}/_baseline/gkylsoft",
            "CI_PR_PREFIX=${env.WORKSPACE}/gkylsoft",
            "CI_REGRESSION_JOBS=${jobs}",
            "CI_REGRESSION_TEST_TIMEOUT=${timeout}"
        ]
    )
}

def configureAndCompileCRegressions(String driver, String sourceDir, String prefix, String moduleFile) {
    withEnv([
        "CI_REGRESSION_DRIVER=${driver}",
        "CI_REGRESSION_SOURCE_DIR=${sourceDir}",
        "CI_REGRESSION_PREFIX=${prefix}",
        "CI_REGRESSION_MODULE_FILE=${moduleFile}"
    ]) {
        sh '''#!/bin/bash -l
            set -euo pipefail
            . "$CI_REGRESSION_MODULE_FILE"
            "$CI_REGRESSION_DRIVER" runregression configure \
                --source-dir "$CI_REGRESSION_SOURCE_DIR" \
                --prefix "$CI_REGRESSION_PREFIX"
            "$CI_REGRESSION_DRIVER" runregression run -c compile
        '''
    }
}

def finalizeUnfinishedSlurmJob() {
    // Jenkins may terminate a durable-task process tree before its shell trap
    // completes. Run this from the Pipeline finally block as a second chance
    // to cancel a submitted job and preserve an abort-status artifact.
    sh '''#!/bin/bash -l
        set -euo pipefail

        for id_file in slurm-*-job-id.txt; do
            [[ -e "$id_file" ]] || continue
            status_file="${id_file%-id.txt}-status.txt"
            [[ -e "$status_file" ]] && continue

            job_id="$(<"$id_file")"
            if [[ ! "$job_id" =~ ^[0-9]+(_[0-9]+)?$ ]]; then
                printf 'job_id=%s\nstate=UNKNOWN\nexit_code=\n' "$job_id" > "$status_file"
                echo "WARNING: Cannot cancel malformed Slurm job ID '$job_id'" >&2
                continue
            fi

            echo "Pipeline finalizer: cancelling unfinished Slurm job $job_id"
            scancel "$job_id" || true
            while :; do
                state="$(squeue --noheader --jobs="$job_id" --format='%T' | head -n 1 || true)"
                if [[ -z "$state" ]]; then
                    break
                fi
                echo "Pipeline finalizer: waiting for job $job_id to stop (state: $state)"
                sleep 5
            done
            printf 'job_id=%s\nstate=CANCELLED_BY_JENKINS\nexit_code=\n' "$job_id" > "$status_file"
        done
    '''
}

if (!(params.PR_NUMBER ==~ /[1-9][0-9]*/)) {
    error("PR_NUMBER must be a positive integer, got '${params.PR_NUMBER}'.")
}

def nodeLabel = (env.STELLAR_INTEL_NODE_LABEL ?: 'stellar-intel').trim()
def gkeyllCiRoot = requireValue('GKEYLL_CI_ROOT', env.GKEYLL_CI_ROOT)
def workspaceRoot = "${gkeyllCiRoot}/workspaces"
def credentialsId = requireValue('STELLAR_GITHUB_CREDENTIAL_ID', env.STELLAR_GITHUB_CREDENTIAL_ID)
def prCommit = ''
def terminalStatus = 'failure'
def terminalDescription = 'Stellar Intel CPU CI failed.'

node(nodeLabel) {
    // Stellar compute nodes must see this path. Configure the root on a shared
    // filesystem such as the project's /scratch/gpfs location, never /tmp.
    ws("${workspaceRoot}/${env.JOB_NAME}/${env.BUILD_TAG}") {
        try {
            stage('Checkout PR') {
                deleteDir()
                checkoutPullRequest(credentialsId)
                prCommit = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                writeFile file: 'ci-pr-commit.txt', text: "${prCommit}\n"
                sh 'git status --short'
            }
            stage('Report pending to GitHub') {
                publishGitHubCommitStatus(
                    credentialsId,
                    prCommit,
                    'pending',
                    'Stellar Intel CPU CI is running.'
                )
            }
            stage('Build dependencies') {
                withEnv(["PREFIX=${env.WORKSPACE}/gkylsoft"]) {
                    sh '''#!/bin/bash -l
                        set -euo pipefail
                        ./machines/mkdeps.stellar-intel.sh
                    '''
                }
            }
            stage('Configure') {
                withEnv(["PREFIX=${env.WORKSPACE}/gkylsoft"]) {
                    sh '''#!/bin/bash -l
                        set -euo pipefail
                        ./machines/configure.stellar-intel.sh
                    '''
                }
            }
            stage('Build unit tests') {
                def jobs = buildJobs()
                sh """#!/bin/bash -l
                    set -euo pipefail
                    # Each Jenkins sh step is a new process, so source the
                    # same environment used by the Stellar machine scripts.
                    . machines/module_load.stellar-intel.sh
                    module list
                    make -j${jobs} unit
                """
            }
            stage('Run unit tests (SLURM)') {
                submitUnitTests()
            }
            stage('Install PR for C regression') {
                def jobs = buildJobs()
                sh """#!/bin/bash -l
                    set -euo pipefail
                    . machines/module_load.stellar-intel.sh
                    make -j${jobs} install
                """
            }
            stage('Compile PR C regressions') {
                configureAndCompileCRegressions(
                    "${env.WORKSPACE}/gkylsoft/gkeyll/bin/gkeyll",
                    env.WORKSPACE,
                    "${env.WORKSPACE}/gkylsoft",
                    'machines/module_load.stellar-intel.sh'
                )
            }
            stage('Checkout Stellar Intel baseline') {
                dir('_baseline') {
                    deleteDir()
                    checkoutRegressionBaseline(credentialsId)
                    sh 'git rev-parse HEAD | tee ../ci-baseline-commit.txt'
                }
            }
            stage('Build Stellar Intel baseline') {
                withEnv(["PREFIX=${env.WORKSPACE}/_baseline/gkylsoft"]) {
                    dir('_baseline') {
                        sh '''#!/bin/bash -l
                            set -euo pipefail
                            . ../machines/module_load.stellar-intel.sh
                            ./machines/mkdeps.stellar-intel.sh
                            ./machines/configure.stellar-intel.sh
                        '''
                    }
                }
            }
            stage('Install Stellar Intel baseline') {
                def jobs = buildJobs()
                dir('_baseline') {
                    sh """#!/bin/bash -l
                        set -euo pipefail
                        . ../machines/module_load.stellar-intel.sh
                        make -j${jobs} install
                    """
                }
            }
            stage('Compile Stellar Intel baseline C regressions') {
                configureAndCompileCRegressions(
                    "${env.WORKSPACE}/_baseline/gkylsoft/gkeyll/bin/gkeyll",
                    "${env.WORKSPACE}/_baseline",
                    "${env.WORKSPACE}/_baseline/gkylsoft",
                    'machines/module_load.stellar-intel.sh'
                )
            }
            stage('Run C regressions (SLURM)') {
                submitRegressionTests()
            }
            terminalStatus = 'success'
            terminalDescription = 'Stellar Intel CPU unit and C regression tests passed.'
        } catch (err) {
            if (currentBuild.currentResult == 'ABORTED' || err.toString().contains('FlowInterruptedException')) {
                terminalStatus = 'error'
                terminalDescription = 'Stellar Intel CPU CI was aborted.'
            }
            throw err
        } finally {
            try {
                finalizeUnfinishedSlurmJob()
            } catch (err) {
                terminalStatus = 'error'
                terminalDescription = 'Stellar Intel CPU CI cleanup failed.'
                throw err
            } finally {
                try {
                    archiveArtifacts allowEmptyArchive: true,
                        artifacts: 'ci-pr-commit.txt,ci-baseline-commit.txt,slurm-*.out,slurm-*-job-id.txt,slurm-*-job-status.txt,build/**/*.log,gkylsoft/gkeyll-results/**/regressiondb,gkylsoft/gkeyll-results/**/_rr_failures.txt,_baseline/gkylsoft/gkeyll-results/**/regressiondb,_baseline/gkylsoft/gkeyll-results/**/_rr_failures.txt'
                } catch (err) {
                    terminalStatus = 'error'
                    terminalDescription = 'Stellar Intel CPU CI artifact archival failed.'
                    throw err
                } finally {
                    try {
                        if (prCommit) {
                            publishGitHubCommitStatus(
                                credentialsId,
                                prCommit,
                                terminalStatus,
                                terminalDescription
                            )
                        }
                    } finally {
                        deleteDir()
                    }
                }
            }
        }
    }
}
